<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="NautilusNameCell" parent="NautilusViewCell">
    <child>
      <object class="GtkBox" id="top_child">
        <child>
          <object class="GtkTreeExpander" id="expander">
            <property name="indent-for-icon">false</property>
            <property name="focusable">false</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="content">
            <property name="spacing">6</property>
            <property name="orientation">0</property>
            <property name="halign">0</property>
            <property name="valign">3</property>
            <child>
              <object class="GtkCenterBox" id="fixed_height_box">
                <property name="valign">3</property>
                <property name="width-request" bind-source="NautilusNameCell" bind-property="icon-size" bind-flags="sync-create"/>
                <property name="height-request" bind-source="NautilusNameCell" bind-property="icon-size" bind-flags="sync-create"/>
                <property name="center-widget">
                  <object class="GtkOverlay">
                    <child>
                      <object class="NautilusImage" id="icon">
                        <property name="valign">center</property>
                        <accessibility>
                          <relation name="labelled-by">label</relation>
                        </accessibility>
                      </object>
                    </child>
                    <child type="overlay">
                      <object class="GtkBox" id="emblems_box">
                        <property name="orientation">0</property>
                        <property name="halign">2</property>
                        <property name="valign">2</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">1</property>
                <property name="halign">0</property>
                <property name="hexpand">true</property>
                <property name="valign">3</property>
                <style>
                  <class name="column-name-labels-box"/>
                </style>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">0</property>
                    <property name="halign">0</property>
                    <property name="hexpand">true</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="label">
                        <property name="ellipsize">2</property>
                        <property name="lines">1</property>
                        <property name="max-width-chars">-1</property>
                        <property name="wrap">false</property>
                        <property name="wrap-mode">2</property>
                        <property name="halign">1</property>
                        <property name="has-tooltip">true</property>
                        <property name="attributes">0 -1 insert-hyphens false</property>
                        <signal name="query-tooltip" handler="on_label_query_tooltip"/>
                        <binding name="label">
                          <lookup name="display-name" type="NautilusFile">
                            <lookup name="file" type="NautilusViewItem">
                              <lookup name="item" type="NautilusNameCell">NautilusNameCell</lookup>
                            </lookup>
                          </lookup>
                        </binding>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSpinner" id="spinner">
                        <property name="visible">false</property>
                        <property name="halign">3</property>
                        <property name="valign">3</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="path">
                    <property name="visible">false</property>
                    <property name="ellipsize">1</property>
                    <property name="justify">0</property>
                    <property name="halign">0</property>
                    <property name="xalign">0</property>
                    <property name="attributes">0 -1 insert-hyphens false</property>
                    <style>
                      <class name="caption"/>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuButton" id="snippet_button">
                <property name="tooltip-text" translatable="yes">Full Text Match</property>
                <property name="visible">false</property>
                <property name="icon-name">quotation-symbolic</property>
                <property name="valign">3</property>
                <style>
                  <class name="fts-snippet"/>
                </style>
                <property name="popover">
                  <object class="GtkPopover">
                    <child>
                      <object class="GtkLabel" id="snippet">
                        <property name="ellipsize">0</property>
                        <property name="justify">0</property>
                        <property name="max-width-chars">65</property>
                        <property name="lines">10</property>
                        <property name="wrap">true</property>
                        <property name="wrap-mode">0</property>
                      </object>
                    </child>
                    <signal name="show" handler="popover_show_cb" object="NautilusNameCell"/>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
